%{
/* thai h2asm.uhin: generated from the thai lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

จำนวนเต็ม                   {printf("INT");}
มิฉะนั้น                    {printf("ELSE");}
anta_h                      {printf("IN");}
ขณะ                         {printf("WHILE");}
ถ้า                         {printf("IF");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
