%{
/* thai asm2h.uhin: generated from the thai lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("ขณะ");}
ELSE                        {printf("มิฉะนั้น");}
AND                         {printf("ca");}
INT                         {printf("จำนวนเต็ม");}
NOT                         {printf("na");}
IF                          {printf("ถ้า");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
