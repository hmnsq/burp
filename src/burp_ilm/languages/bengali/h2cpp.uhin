প্রধান                      {printf("main");}
মিথ্যা                      {printf("false");}
শ্রেণী                      {printf("class");}
অক্ষর                       {printf("char");}
আভাসী                       {printf("virtual");}
ছোড়ো                       {printf("throw");}
দশমিক                       {printf("float");}
ফাঁকা                       {printf("NULL");}
বিরতি                       {printf("break");}
