তোলো                        {printf("raise");}
নতুন                        {printf("new");}
ফেরত                        {printf("return");}
সত্য                        {printf("True");}
সুতা                        {printf("Thread");}
এবং                         {printf("and");}
করো                         {printf("do");}
দাও                         {printf("yield");}
ধরো                         {printf("catch");}
নয়                         {printf("not");}
পরম                         {printf("super");}
যখন                         {printf("while");}
যদি                         {printf("if");}
যাও                         {printf("goto");}
লিখ                         {printf("write");}
ইব                          {printf("as");}
