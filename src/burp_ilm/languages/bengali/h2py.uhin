মিথ্যা                      {printf("False");}
শ্রেণী                      {printf("class");}
অক্ষর                       {printf("char");}
অনামা                       {printf("lambda");}
ছোড়ো                       {printf("throw");}
দশমিক                       {printf("float");}
বস্তু                       {printf("Object");}
বাক্য                       {printf("String");}
বিরতি                       {printf("break");}
মধ্যে                       {printf("in");}
মোড়ক                       {printf("package");}
