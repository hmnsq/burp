ਟਿੱਪਣੀ                      {printf("rem");}
ਬੁਲਾਓ                       {printf("CALL");}
ਆਕਾਰ                        {printf("dim");}
ਛਾਪੋ                        {printf("print");}
ਜਦੋਂ                        {printf("WHILE");}
ਨਹੀਂ                        {printf("NOT");}
ਪੂਰਨ                        {printf("INT");}
ਬਾਕੀ                        {printf("mod");}
ਮੰਨੋ                        {printf("LET");}
ਵਾਪਸ                        {printf("RETURN");}
ਸਥਿਰ                        {printf("STATIC");}
ਅਚਲ                         {printf("CONST");}
ਅਤੇ                         {printf("AND");}
ਅੰਤ                         {printf("END");}
