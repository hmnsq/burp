%{
/* telugu h2asm.uhin: generated from the telugu lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

అధ్యవస్యతి                  {printf("ASSUME");}
అన్తర్భావ                   {printf("INCLUDE");}
పూర్ణాంకం                   {printf("INT");}
ముగింపు                     {printf("END");}
లేకపోతే                     {printf("ELSE");}
వైశ్విక                     {printf("global");}
పిలువు                      {printf("CALL");}
బహిరంగ                      {printf("PUBLIC");}
విధానం                      {printf("PROC");}
అయితే                       {printf("WHILE");}
ఒకవేళ                       {printf("IF");}
బాహ్య                       {printf("EXTERN");}
మరియు                       {printf("AND");}
సూచిక                       {printf("PTR");}
కాదు                        {printf("NOT");}
తాళం                        {printf("LOCK");}
లేదా                        {printf("OR");}
ఇది                         {printf("THIS");}
రకం                         {printf("TYPE");}
లో                          {printf("IN");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
