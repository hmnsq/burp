%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

clearscreen                 {printf("తెర_శుభ్రం");}
forward                     {printf("అగ్రప్రసార");}
pendown                     {printf("కలం_దించు");}
ifelse                      {printf("అయితే_లేకపోతే");}
repeat                      {printf("పునరావృతం");}
penup                       {printf("కలం_ఎత్తు");}
print                       {printf("ముద్రించు");}
right                       {printf("కుడి");}
back                        {printf("వెనుకకు");}
home                        {printf("ఇల్లు");}
left                        {printf("ఎడమ");}
make                        {printf("చేయి");}
end                         {printf("ముగింపు");}
if                          {printf("ఒకవేళ");}
to                          {printf("వరకు");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
