అగ్రప్రసార                  {printf("forward");}
తెర_శుభ్రం                  {printf("clearscreen");}
కలం_ఎత్తు                   {printf("penup");}
కలం_దించు                   {printf("pendown");}
పునరావృతం                   {printf("repeat");}
ముద్రించు                   {printf("print");}
ముగింపు                     {printf("end");}
వెనుకకు                     {printf("back");}
ఇల్లు                       {printf("home");}
ఒకవేళ                       {printf("if");}
కుడి                        {printf("right");}
చేయి                        {printf("make");}
వరకు                        {printf("to");}
ఎడమ                         {printf("left");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
