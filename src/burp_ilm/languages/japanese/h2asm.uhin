%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

ながら                         {printf("WHILE");}
もし                          {printf("IF");}
否则                          {printf("ELSE");}
整数                          {printf("INT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
