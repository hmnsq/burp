%{
/* japanese b2h.uhin: generated from the japanese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

RETURN                      {printf("戻る");}
return                      {printf("戻る");}
WHILE                       {printf("ながら");}
while                       {printf("ながら");}
ELSE                        {printf("否则");}
FOR                         {printf("ために");}
INT                         {printf("整数");}
for                         {printf("ために");}
IF                          {printf("もし");}
if                          {printf("もし");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
