%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

استثناء                     {printf("except");}
افتراضي                     {printf("default");}
وإلاإذا                     {printf("elif");}
استورد                      {printf("import");}
متطاير                      {printf("volatile");}
أخيرا                       {printf("finally");}
استمر                       {printf("continue");}
رئيسي                       {printf("main");}
طالما                       {printf("while");}
مجهول                       {printf("lambda");}
مزدوج                       {printf("double");}
واجهة                       {printf("interface");}
أرجع                        {printf("return");}
أعلى                        {printf("super");}
أنتج                        {printf("yield");}
اذهب                        {printf("goto");}
ارفع                        {printf("raise");}
افعل                        {printf("do");}
اقرأ                        {printf("read");}
اكتب                        {printf("write");}
اكسر                        {printf("break");}
امسك                        {printf("catch");}
ثابت                        {printf("const");}
جديد                        {printf("new");}
حالة                        {printf("case");}
حاول                        {printf("try");}
حزمة                        {printf("package");}
ساكن                        {printf("static");}
صحيح                        {printf("True");}
عائم                        {printf("float");}
فراغ                        {printf("void");}
كائن                        {printf("Object");}
مجرد                        {printf("abstract");}
محمي                        {printf("protected");}
وإلا                        {printf("else");}
يمتد                        {printf("extends");}
ينفذ                        {printf("implements");}
أكد                         {printf("assert");}
إذا                         {printf("if");}
ارم                         {printf("throw");}
بدل                         {printf("switch");}
حرف                         {printf("char");}
خاص                         {printf("private");}
خطأ                         {printf("False");}
خيط                         {printf("Thread");}
صنف                         {printf("class");}
عام                         {printf("global");}
لكل                         {printf("for");}
ليس                         {printf("not");}
نوم                         {printf("sleep");}
هذا                         {printf("this");}
أو                          {printf("or");}
في                          {printf("in");}
كـ                          {printf("as");}
من                          {printf("from");}
نص                          {printf("String");}
و                           {printf("and");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
