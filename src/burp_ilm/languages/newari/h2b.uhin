%{
/* newari h2b.uhin: generated from the newari lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

कालयन्त्र                   {printf("TIMER");}
पूर्णाङ्क                   {printf("INT");}
प्रत्यागम                   {printf("RETURN");}
सहभाजित                     {printf("SHARED");}
अन्यथा                      {printf("ELSE");}
आह्वान                      {printf("CALL");}
पदावली                      {printf("STRING");}
अस्तु                       {printf("LET");}
ध्रुव                       {printf("CONST");}
प्रति                       {printf("FOR");}
यावत्                       {printf("WHILE");}
स्थिर                       {printf("STATIC");}
अन्त                        {printf("END");}
कुरु                        {printf("DO");}
गच्छ                        {printf("GOTO");}
यदि                         {printf("IF");}
इव                          {printf("AS");}
वा                          {printf("OR");}
च                           {printf("AND");}
न                           {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
