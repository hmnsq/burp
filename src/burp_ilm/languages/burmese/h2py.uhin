%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

ni_spaadita                 {printf("implements");}
ကိန်းပြည့်                  {printf("int");}
dviguu_na                   {printf("double");}
gr_haa_na                   {printf("catch");}
antata_h                    {printf("finally");}
ca_ncala                    {printf("volatile");}
rak_sita                    {printf("protected");}
su_supti                    {printf("sleep");}
vistr_ta                    {printf("extends");}
မဟုတ်ပါက                    {printf("else");}
bha_nga                     {printf("break");}
ပြန်ပေး                     {printf("return");}
anta_h                      {printf("in");}
k_sipa                      {printf("throw");}
pak_sa                      {printf("case");}
var_na                      {printf("char");}
နေစဉ်                       {printf("while");}
အကယ်၍                       {printf("if");}
အတွက်                       {printf("for");}
ta_h                        {printf("from");}
ca                          {printf("and");}
na                          {printf("not");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
