%{
/* burmese asm2h.uhin: generated from the burmese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("နေစဉ်");}
ELSE                        {printf("မဟုတ်ပါက");}
AND                         {printf("ca");}
INT                         {printf("ကိန်းပြည့်");}
NOT                         {printf("na");}
IF                          {printf("အကယ်၍");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
