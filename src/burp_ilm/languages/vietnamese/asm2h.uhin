%{
/* vietnamese asm2h.uhin: generated from the vietnamese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("trong_khi");}
ELSE                        {printf("không_thì");}
INT                         {printf("số_nguyên");}
IF                          {printf("nếu");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
