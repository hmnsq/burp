%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("поки");}
ELSE                        {printf("інакше");}
INT                         {printf("ціле");}
IF                          {printf("якщо");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
