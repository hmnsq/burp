%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

return                      {printf("повернути");}
\#else                      {printf("#інакше");}
while                       {printf("поки");}
else                        {printf("інакше");}
\#if                        {printf("#якщо");}
for                         {printf("для");}
int                         {printf("ціле");}
if                          {printf("якщо");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
