%{
/* ukrainian h2c.uhin: generated from the ukrainian lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

повернути                   {printf("return");}
\#інакше                    {printf("#else");}
інакше                      {printf("else");}
\#якщо                      {printf("#if");}
поки                        {printf("while");}
ціле                        {printf("int");}
якщо                        {printf("if");}
для                         {printf("for");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
