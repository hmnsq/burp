   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

INCLUDE                     {printf("ضمن");}
ASSUME                      {printf("افترض");}
EXTERN                      {printf("خارجي");}
PUBLIC                      {printf("عام");}
WHILE                       {printf("طالما");}
CALL                        {printf("نادي");}
ELSE                        {printf("وإلا");}
LOCK                        {printf("قفل");}
PROC                        {printf("إجراء");}
THIS                        {printf("هذا");}
TYPE                        {printf("نوع");}
call                        {printf("نادي");}
AND                         {printf("𐤅");}
END                         {printf("𐤒𐤑");}
INT                         {printf("صحيح");}
NOT                         {printf("𐤋𐤀");}
PTR                         {printf("مؤشر");}
IF                          {printf("𐤀𐤌");}
IN                          {printf("في");}
OR                          {printf("𐤀𐤅");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
