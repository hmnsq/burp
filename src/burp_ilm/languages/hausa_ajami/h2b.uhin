%{
/* hausa_ajami h2b.uhin: generated from the hausa_ajami lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

طالما                       {printf("WHILE");}
مشترك                       {printf("SHARED");}
أرجع                        {printf("RETURN");}
اذهب                        {printf("GOTO");}
افعل                        {printf("DO");}
انته                        {printf("END");}
ثابت                        {printf("CONST");}
ساكن                        {printf("STATIC");}
صحيح                        {printf("INT");}
ليكن                        {printf("LET");}
مؤقت                        {printf("TIMER");}
نادي                        {printf("CALL");}
وإلا                        {printf("ELSE");}
إذا                         {printf("IF");}
لكل                         {printf("FOR");}
ليس                         {printf("NOT");}
أو                          {printf("OR");}
كـ                          {printf("AS");}
نص                          {printf("STRING");}
و                           {printf("AND");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
