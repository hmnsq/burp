%{
/* khmer h2b.uhin: generated from the khmer lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

បើមិនដូច្នេះ                {printf("ELSE");}
ចំនួនគត់                    {printf("INT");}
ប្រសិនបើ                    {printf("IF");}
សម្រាប់                     {printf("FOR");}
ខណៈពេល                      {printf("WHILE");}
ត្រឡប់                      {printf("RETURN");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
