%{
/* khmer asm2h.uhin: generated from the khmer lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("ខណៈពេល");}
ELSE                        {printf("បើមិនដូច្នេះ");}
AND                         {printf("ca");}
INT                         {printf("ចំនួនគត់");}
NOT                         {printf("na");}
IF                          {printf("ប្រសិនបើ");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
