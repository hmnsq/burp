\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

បើមិនដូច្នេះ                {printf("else");}
ni_spaadita                 {printf("implements");}
dviguu_na                   {printf("double");}
gr_haa_na                   {printf("catch");}
antata_h                    {printf("finally");}
ca_ncala                    {printf("volatile");}
rak_sita                    {printf("protected");}
su_supti                    {printf("sleep");}
vistr_ta                    {printf("extends");}
ចំនួនគត់                    {printf("int");}
ប្រសិនបើ                    {printf("if");}
bha_nga                     {printf("break");}
សម្រាប់                     {printf("for");}
anta_h                      {printf("in");}
k_sipa                      {printf("throw");}
pak_sa                      {printf("case");}
var_na                      {printf("char");}
ខណៈពេល                      {printf("while");}
ត្រឡប់                      {printf("return");}
ta_h                        {printf("from");}
ca                          {printf("and");}
na                          {printf("not");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
