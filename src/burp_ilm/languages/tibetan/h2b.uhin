%{
/* tibetan h2b.uhin: generated from the tibetan lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

ཆེད་དུ                      {printf("FOR");}
དེ་མིན                      {printf("ELSE");}
གལ་ཏེ                       {printf("IF");}
ཕྱིར                        {printf("RETURN");}
སྐབས                        {printf("WHILE");}
ཧྲིལ                        {printf("INT");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
