%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("докато");}
ELSE                        {printf("иначе");}
INT                         {printf("цяло");}
IF                          {printf("ако");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
