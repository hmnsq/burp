%{
/* lepcha h2b.uhin: generated from the lepcha lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

puur_naa_nka                {printf("INT");}
ᰀᰧᰀ                         {printf("ELSE");}
ᰀᰧᰌ                         {printf("RETURN");}
ca                          {printf("AND");}
na                          {printf("NOT");}
ᰀᰧ                          {printf("IF");}
ᰀᰬ                          {printf("WHILE");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
