%{
/* sindhi h2logo.uhin: generated from the sindhi lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

جيڪڏهن_ٻي_صورت              {printf("ifelse");}
پردو_صاف                    {printf("clearscreen");}
قلم_مٿي                     {printf("penup");}
قلم_هيٺ                     {printf("pendown");}
ورجايو                      {printf("repeat");}
أمامي                       {printf("forward");}
تائين                       {printf("to");}
ٺاهيو                       {printf("make");}
پوئتي                       {printf("back");}
ڇاپيو                       {printf("print");}
انته                        {printf("end");}
ساڄي                        {printf("right");}
کاٻي                        {printf("left");}
إذا                         {printf("if");}
گهر                         {printf("home");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
