%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

INCLUDE                     {printf("अन्तर्भाव");}
ASSUME                      {printf("अध्यवस्यति");}
EXTERN                      {printf("बाह्य");}
PUBLIC                      {printf("सार्वजनिक");}
global                      {printf("वैश्विक");}
WHILE                       {printf("जबसम्म");}
CALL                        {printf("आह्वान");}
ELSE                        {printf("अन्यथा");}
LOCK                        {printf("तालक");}
PROC                        {printf("विधि");}
THIS                        {printf("एतत्");}
TYPE                        {printf("प्रकार");}
call                        {printf("आह्वान");}
AND                         {printf("र");}
END                         {printf("अन्त्य");}
INT                         {printf("पूर्णाङ्क");}
NOT                         {printf("होइन");}
PTR                         {printf("निर्देशक");}
div                         {printf("भाग");}
IF                          {printf("यदि");}
IN                          {printf("अन्तः");}
OR                          {printf("वा");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
