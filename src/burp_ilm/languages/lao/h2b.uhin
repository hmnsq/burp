%{
/* lao h2b.uhin: generated from the lao lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

ບໍ່ດັ່ງນັ້ນ                 {printf("ELSE");}
ຈຳນວນເຕັມ                   {printf("INT");}
ໃນຂະນະທີ່                   {printf("WHILE");}
ສົ່ງຄືນ                     {printf("RETURN");}
ສຳລັບ                       {printf("FOR");}
ຖ້າ                         {printf("IF");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
