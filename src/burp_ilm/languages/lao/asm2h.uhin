%{
/* lao asm2h.uhin: generated from the lao lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("ໃນຂະນະທີ່");}
ELSE                        {printf("ບໍ່ດັ່ງນັ້ນ");}
AND                         {printf("ca");}
INT                         {printf("ຈຳນວນເຕັມ");}
NOT                         {printf("na");}
IF                          {printf("ຖ້າ");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
