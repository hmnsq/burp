দ্ৱিগুণ                     {printf("double");}
ৱিস্তৃত                     {printf("extends");}
ৱৈশ্ৱিক                     {printf("global");}
অনামন্                      {printf("lambda");}
অন্ততঃ                      {printf("finally");}
অন্যথা                      {printf("else");}
অমূর্ত                      {printf("abstract");}
পদাৱলী                      {printf("String");}
