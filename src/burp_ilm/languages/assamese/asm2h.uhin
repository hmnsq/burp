ASSUME                      {printf("অধ্যৱস্যতি");}
EXTERN                      {printf("বাহ্য");}
PUBLIC                      {printf("সার্ৱজনিক");}
global                      {printf("ৱৈশ্ৱিক");}
WHILE                       {printf("যেতিয়ালৈ");}
CALL                        {printf("আহ্ৱান");}
ELSE                        {printf("অন্যথা");}
LOCK                        {printf("তালক");}
PROC                        {printf("ৱিধি");}
THIS                        {printf("এতত্");}
TYPE                        {printf("প্রকার");}
call                        {printf("আহ্ৱান");}
AND                         {printf("আৰু");}
END                         {printf("শেষ");}
INT                         {printf("পূর্ণাঙ্ক");}
