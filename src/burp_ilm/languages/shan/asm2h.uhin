%{
/* shan asm2h.uhin: generated from the shan lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("ၶၢဝ်း");}
ELSE                        {printf("ပေႃးဢမ်ႇ");}
AND                         {printf("ca");}
INT                         {printf("puur_naa_nka");}
NOT                         {printf("na");}
IF                          {printf("ပေႃး");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
