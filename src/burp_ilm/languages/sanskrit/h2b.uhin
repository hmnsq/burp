%{
/* sanskrit h2b.uhin: generated from the sanskrit lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

उपकार्यं_गच्छ               {printf("gosub");}
यावत्_अन्तः                 {printf("wend");}
कालयन्त्र                   {printf("TIMER");}
पर्यन्तम्                   {printf("to");}
पूर्णाङ्क                   {printf("INT");}
प्रत्यागम                   {printf("RETURN");}
निर्गमः_                    {printf("OUTPUT");}
टिप्पणी                     {printf("rem");}
सहभाजित                     {printf("SHARED");}
अग्रिम                      {printf("next");}
अन्यथा                      {printf("ELSE");}
आह्वान                      {printf("CALL");}
निवेशः                      {printf("INPUT");}
निवेशय                      {printf("input");}
पदावली                      {printf("STRING");}
मुद्रय                      {printf("print");}
अस्तु                       {printf("LET");}
तर्हि                       {printf("then");}
ध्रुव                       {printf("CONST");}
प्रति                       {printf("FOR");}
यावत्                       {printf("WHILE");}
स्थिर                       {printf("STATIC");}
अन्त                        {printf("END");}
आयाम                        {printf("dim");}
कुरु                        {printf("DO");}
गच्छ                        {printf("GOTO");}
पदम्                        {printf("step");}
शेषः                        {printf("mod");}
यदि                         {printf("IF");}
इव                          {printf("AS");}
वा                          {printf("OR");}
च                           {printf("AND");}
न                           {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
