%{
/* russian asm2h.uhin: generated from the russian lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("пока");}
ELSE                        {printf("иначе");}
INT                         {printf("целое");}
IF                          {printf("если");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
