\#else                      {printf("#иначе");}
while                       {printf("пока");}
else                        {printf("иначе");}
main                        {printf("основной");}
\#if                        {printf("#если");}
for                         {printf("для");}
int                         {printf("целое");}
if                          {printf("если");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
