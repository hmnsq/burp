%{
/* pashto h2b.uhin: generated from the pashto lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

پای_ترهغه                   {printf("wend");}
ځه_فرعي                     {printf("gosub");}
ګام_په                      {printf("step");}
بل_ځل                       {printf("next");}
تبصره                       {printf("rem");}
طالما                       {printf("WHILE");}
مشترك                       {printf("SHARED");}
واخله                       {printf("input");}
أرجع                        {printf("RETURN");}
اذهب                        {printf("GOTO");}
افعل                        {printf("DO");}
انته                        {printf("END");}
ثابت                        {printf("CONST");}
ساكن                        {printf("STATIC");}
صحيح                        {printf("INT");}
ليكن                        {printf("LET");}
مؤقت                        {printf("TIMER");}
نادي                        {printf("CALL");}
وإلا                        {printf("ELSE");}
پاتی                        {printf("mod");}
إذا                         {printf("IF");}
بعد                         {printf("dim");}
لكل                         {printf("FOR");}
ليس                         {printf("NOT");}
چاپ                         {printf("print");}
أو                          {printf("OR");}
تر                          {printf("to");}
كـ                          {printf("AS");}
نص                          {printf("STRING");}
نو                          {printf("then");}
و                           {printf("AND");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
