%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

\#که_نه_تعریف_شوی           {printf("#ifndef");}
حافظه_صفر_ورکړه             {printf("calloc");}
که_توری_یا_عدد              {printf("isalnum");}
\#که_تعریف_شوی              {printf("#ifdef");}
