%{
/* chinese b2h.uhin: generated from the chinese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

RETURN                      {printf("返回");}
return                      {printf("返回");}
WHILE                       {printf("当");}
while                       {printf("当");}
ELSE                        {printf("否则");}
FOR                         {printf("为");}
INT                         {printf("整数");}
for                         {printf("为");}
IF                          {printf("如果");}
if                          {printf("如果");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
