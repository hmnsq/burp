%{
/* pali yacc2h.uhin: generated from the pali lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

protected                   {printf("रक्षित");}
\#include                   {printf("#अन्तर्भाव");}
continue                    {printf("अनुवर्त");}
register                    {printf("पञ्जिका");}
volatile                    {printf("चञ्चल");}
default                     {printf("स्वभाव");}
private                     {printf("गुप्त");}
typedef                     {printf("प्रकारनिर्देश");}
virtual                     {printf("आभास");}
assert                      {printf("प्रतिज्ञा");}
double                      {printf("द्विगुण");}
extern                      {printf("बाह्य");}
inline                      {printf("अन्तःस्थ");}
public                      {printf("सार्वजनिक");}
return                      {printf("पटिनिवत्त");}
signal                      {printf("सङ्केत");}
sizeof                      {printf("परिमाण");}
static                      {printf("स्थिर");}
struct                      {printf("संरचना");}
switch                      {printf("विकल्प");}
\#elif                      {printf("#नोचेद्यदि");}
\#else                      {printf("#अञ्ञथा");}
break                       {printf("भङ्ग");}
const                       {printf("ध्रुव");}
float                       {printf("भिन्न");}
raise                       {printf("उत्थापय");}
union                       {printf("सङ्घ");}
while                       {printf("याव");}
write                       {printf("लिख");}
NULL                        {printf("रिक्त");}
case                        {printf("पक्ष");}
char                        {printf("वर्ण");}
else                        {printf("अञ्ञथा");}
enum                        {printf("गणना");}
free                        {printf("मुक्त");}
goto                        {printf("गच्छ");}
main                        {printf("पधान");}
read                        {printf("पठ");}
type                        {printf("प्रकार");}
void                        {printf("शून्य");}
\#if                        {printf("#सचे");}
for                         {printf("अत्थाय");}
int                         {printf("पूर्णाङ्क");}
do                          {printf("करोहि");}
if                          {printf("सचे");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
