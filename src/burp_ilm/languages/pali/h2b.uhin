%{
/* pali h2b.uhin: generated from the pali lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

कालयन्त्र                   {printf("TIMER");}
पटिनिवत्त                   {printf("RETURN");}
पूर्णाङ्क                   {printf("INT");}
सहभाजित                     {printf("SHARED");}
अञ्ञथा                      {printf("ELSE");}
अत्थाय                      {printf("FOR");}
आह्वान                      {printf("CALL");}
पदावली                      {printf("STRING");}
अस्तु                       {printf("LET");}
करोहि                       {printf("DO");}
ध्रुव                       {printf("CONST");}
स्थिर                       {printf("STATIC");}
अन्त                        {printf("END");}
गच्छ                        {printf("GOTO");}
याव                         {printf("WHILE");}
सचे                         {printf("IF");}
इव                          {printf("AS");}
वा                          {printf("OR");}
च                           {printf("AND");}
न                           {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
