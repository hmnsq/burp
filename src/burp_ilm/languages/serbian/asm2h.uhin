%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("док");}
ELSE                        {printf("инако");}
INT                         {printf("цео");}
IF                          {printf("ако");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
