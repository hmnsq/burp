%{
/* tagalog h2b.uhin: generated from the tagalog lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

puur_naa_nka                {printf("INT");}
kung_hindi                  {printf("ELSE");}
habang                      {printf("WHILE");}
ibalik                      {printf("RETURN");}
kung                        {printf("IF");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
