محفوظ                       {printf("protected");}
مختصر                       {printf("short");}
\#اگر                       {printf("#if");}
\#سطر                       {printf("#line");}
آزاد                        {printf("free");}
اقرأ                        {printf("read");}
اكتب                        {printf("write");}
توڑو                        {printf("break");}
ثابت                        {printf("const");}
جاری                        {printf("continue");}
