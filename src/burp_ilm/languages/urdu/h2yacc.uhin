%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

\#اگر_غیر_تعریف_شدہ         {printf("#ifndef");}
زیادہ_سے_زیادہ_عدد          {printf("INT_MAX");}
\#اگر_تعریف_شدہ             {printf("#ifdef");}
\#تعریف_منسوخ               {printf("#undef");}
حرف_یا_ہندسہ                {printf("isalnum");}
صفر_حافظہ_دو                {printf("calloc");}
لڑی_سے_پڑھو                 {printf("sscanf");}
\#تعریف_کرو                 {printf("#define");}
\#وگرنہ_اگر                 {printf("#elif");}
