%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

അഗ്രപ്രസാര                  {printf("forward");}
അവസാനം                      {printf("end");}
എങ്കിൽ                      {printf("if");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
