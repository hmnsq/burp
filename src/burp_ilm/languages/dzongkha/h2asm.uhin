%{
/* dzongkha h2asm.uhin: generated from the dzongkha lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

གལ་སྲིད                     {printf("IF");}
anta_h                      {printf("IN");}
དེ་མིན                      {printf("ELSE");}
སྐབས                        {printf("WHILE");}
ཧྲིལ                        {printf("INT");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
