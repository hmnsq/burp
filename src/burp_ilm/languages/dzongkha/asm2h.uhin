%{
/* dzongkha asm2h.uhin: generated from the dzongkha lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("སྐབས");}
ELSE                        {printf("དེ་མིན");}
AND                         {printf("ca");}
INT                         {printf("ཧྲིལ");}
NOT                         {printf("na");}
IF                          {printf("གལ་སྲིད");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
