ELSE                        {printf("অন্যথা");}
LOCK                        {printf("তালক");}
PROC                        {printf("বিধি");}
THIS                        {printf("এতত্");}
TYPE                        {printf("প্রকার");}
call                        {printf("আহ্বান");}
AND                         {printf("চ");}
END                         {printf("অন্ত");}
