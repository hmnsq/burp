%{
/* aramaic h2b.uhin: generated from the aramaic lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

طالما                       {printf("WHILE");}
مشترك                       {printf("SHARED");}
أرجع                        {printf("RETURN");}
اذهب                        {printf("GOTO");}
ثابت                        {printf("CONST");}
ساكن                        {printf("STATIC");}
صحيح                        {printf("INT");}
ليكن                        {printf("LET");}
مؤقت                        {printf("TIMER");}
نادي                        {printf("CALL");}
وإلا                        {printf("ELSE");}
لكل                         {printf("FOR");}
𐡎𐡅𐡐                         {printf("END");}
𐡏𐡁𐡃                         {printf("DO");}
كـ                          {printf("AS");}
نص                          {printf("STRING");}
𐡀𐡅                          {printf("OR");}
𐡄𐡍                          {printf("IF");}
𐡋𐡀                          {printf("NOT");}
𐡅                           {printf("AND");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
