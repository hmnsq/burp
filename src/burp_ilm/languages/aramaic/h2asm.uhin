%{
/* aramaic h2asm.uhin: generated from the aramaic lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

إجراء                       {printf("PROC");}
افترض                       {printf("ASSUME");}
خارجي                       {printf("EXTERN");}
طالما                       {printf("WHILE");}
صحيح                        {printf("INT");}
مؤشر                        {printf("PTR");}
نادي                        {printf("CALL");}
وإلا                        {printf("ELSE");}
ضمن                         {printf("INCLUDE");}
عام                         {printf("PUBLIC");}
قفل                         {printf("LOCK");}
نوع                         {printf("TYPE");}
هذا                         {printf("THIS");}
𐡎𐡅𐡐                         {printf("END");}
في                          {printf("IN");}
𐡀𐡅                          {printf("OR");}
𐡄𐡍                          {printf("IF");}
𐡋𐡀                          {printf("NOT");}
𐡅                           {printf("AND");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
