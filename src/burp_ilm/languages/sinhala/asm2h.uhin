%{
/* sinhala asm2h.uhin: generated from the sinhala lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of the original Hindawi transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

WHILE                       {printf("අතරතුර");}
ELSE                        {printf("නැතහොත්");}
AND                         {printf("ca");}
INT                         {printf("පූර්ණ_සංඛ්‍යා");}
NOT                         {printf("na");}
IF                          {printf("නම්");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
