%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

පූර්ණ_සංඛ්‍යා               {printf("INT");}
නැතහොත්                     {printf("ELSE");}
anta_h                      {printf("IN");}
අතරතුර                      {printf("WHILE");}
නම්                         {printf("IF");}
ca                          {printf("AND");}
na                          {printf("NOT");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
